<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hostex guest message -> instant wake of hub session noe (scripts/hub_wake_relay.py).
     127.0.0.1:7391 only; public through the Cloudflare tunnel host hooks.aiandtractors.com, HMAC-checked.
     Install: cp to ~/Library/LaunchAgents/ && launchctl bootstrap gui/501 <plist>
     Rollback: launchctl bootout gui/501/com.openclaw.ilbuco-hub-wake-relay (the 2-min poll keeps working). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.openclaw.ilbuco-hub-wake-relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>-I</string>
    <string>/Users/ivan/projects/ilbuco-g2/scripts/hub_wake_relay.py</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>/Users/ivan</string>
    <key>HUB_WAKE_PORT</key><string>7391</string>
    <key>HUB_WAKE_OP_ITEM</key><string>svzbscsucelp32bfigrdpri7ee</string>
  </dict>
  <key>WorkingDirectory</key><string>/Users/ivan/projects/ilbuco-g2</string>
  <key>StandardOutPath</key><string>/Users/ivan/Library/Logs/hub-wake-relay.log</string>
  <key>StandardErrorPath</key><string>/Users/ivan/Library/Logs/hub-wake-relay.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
